{
    "name": "jeremiemercier/fleetview",
    "description": "Nearby technicians map for GLPI tickets, powered by the Masternaut (Michelin Connected Fleet) API",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "config": {
        "autoloader-suffix": "PluginFleetview",
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "GlpiPlugin\\Fleetview\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlpiPlugin\\Fleetview\\Tests\\": "tests/"
        }
    }
}
