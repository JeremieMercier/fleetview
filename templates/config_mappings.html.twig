{% import 'components/form/fields_macros.html.twig' as fields %}
<form method="post" action="{{ mappings_action }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-car me-2"></i>
                {{ __('Vehicle to technician associations', 'fleetview') }}
            </h3>
        </div>
        <div class="card-body">
            {% if vehicles_error is not null %}
                <div class="alert alert-warning" role="alert">{{ vehicles_error }}</div>
            {% elseif vehicles is empty %}
                <div class="alert alert-info" role="alert">
                    {{ __('Configure and save the API access in the API tab to list the fleet vehicles.', 'fleetview') }}
                </div>
            {% else %}
                <p class="text-secondary">
                    {{ __('Associate each Masternaut vehicle with a GLPI user. Rows marked "suggestion" are pre-filled from name matching: save to confirm them.', 'fleetview') }}
                </p>
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>{{ __('Vehicle', 'fleetview') }}</th>
                                <th>{{ __('Registration', 'fleetview') }}</th>
                                <th class="w-50">{{ 'User'|itemtype_name }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for vehicle in vehicles %}
                                <tr>
                                    <td>{{ vehicle.name }}</td>
                                    <td>{{ vehicle.registration }}</td>
                                    <td>
                                        <input type="hidden" name="labels[{{ vehicle.id }}]" value="{{ vehicle.name }}" />
                                        {% do call('User::dropdown', [{
                                            'name': 'mappings[' ~ vehicle.id ~ ']',
                                            'value': vehicle.users_id > 0 ? vehicle.users_id : vehicle.suggested_id,
                                            'right': 'all',
                                            'entity': -1,
                                            'width': '100%',
                                        }]) %}
                                        {% if vehicle.users_id == 0 and vehicle.suggested_id > 0 %}
                                            <span class="badge bg-yellow-lt ms-1">{{ __('suggestion', 'fleetview') }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
        {% if vehicles is not empty %}
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>
                    {{ __('Save') }}
                </button>
            </div>
        {% endif %}
    </div>
</form>
