{% import 'components/form/fields_macros.html.twig' as fields %}

<form method="post" action="{{ form_action }}" data-track-changes="true">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
    <input type="hidden" name="config_context" value="plugin:fleetview" />
    <input type="hidden" name="config_class" value="GlpiPlugin\Fleetview\PluginConfig" />

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-map-pin me-2"></i>
                {{ __('Masternaut (Michelin Connected Fleet) API', 'fleetview') }}
            </h3>
        </div>
        <div class="card-body">
            {{ fields.urlField(
                'api_base_url',
                config['api_base_url'],
                __('API base URL', 'fleetview'),
                {'full_width': true}
            ) }}

            {{ fields.textField(
                'customer_id',
                config['customer_id'],
                __('Connect customer number', 'fleetview'),
                {'full_width': true}
            ) }}

            {{ fields.textField(
                'api_username',
                config['api_username'],
                __('API username (Connect Partner user)', 'fleetview'),
                {'full_width': true}
            ) }}

            {{ fields.passwordField(
                'api_secret',
                '',
                __('API secret', 'fleetview'),
                {
                    'full_width': true,
                    'additional_attributes': {
                        'autocomplete': 'new-password',
                        'placeholder': __('Leave empty to keep the current secret', 'fleetview'),
                    },
                }
            ) }}

            {{ fields.numberField(
                'search_radius',
                config['search_radius'],
                __('Search radius (km)', 'fleetview'),
                {'min': 1, 'max': 500}
            ) }}

            {{ fields.numberField(
                'max_results',
                config['max_results'],
                __('Maximum number of vehicles displayed', 'fleetview'),
                {'min': 1, 'max': 100}
            ) }}

            {{ fields.numberField(
                'cache_lifetime',
                config['cache_lifetime'],
                __('Positions cache lifetime (seconds)', 'fleetview'),
                {'min': 0, 'max': 3600}
            ) }}

            {{ fields.colorField(
                'marker_color_ticket',
                config['marker_color_ticket'],
                __('Marker color: ticket location', 'fleetview')
            ) }}

            {{ fields.colorField(
                'marker_color_top1',
                config['marker_color_top1'],
                __('Marker color: closest vehicle', 'fleetview')
            ) }}

            {{ fields.colorField(
                'marker_color_top2',
                config['marker_color_top2'],
                __('Marker color: 2nd closest', 'fleetview')
            ) }}

            {{ fields.colorField(
                'marker_color_top3',
                config['marker_color_top3'],
                __('Marker color: 3rd closest', 'fleetview')
            ) }}

            {{ fields.urlField(
                'routing_base_url',
                config['routing_base_url'],
                __('Routing service URL (OSRM)', 'fleetview'),
                {
                    'full_width': true,
                    'helper': __('Used to estimate driving times; coordinates are sent to this service. Leave empty to disable.', 'fleetview'),
                }
            ) }}

            {{ fields.sliderField(
                'name_matching_fallback',
                config['name_matching_fallback'],
                __('Match technicians by name when a vehicle has no association', 'fleetview'),
                {
                    'helper': __('Only useful when vehicles are named after their technician. Explicit associations below always take precedence.', 'fleetview'),
                }
            ) }}
        </div>
        <div class="card-footer">
            <button type="submit" name="update" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1"></i>
                {{ __('Save') }}
            </button>
        </div>
    </div>
</form>

<form method="post" action="{{ mappings_action }}" class="mt-3">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-car me-2"></i>
                {{ __('Vehicle to technician associations', 'fleetview') }}
            </h3>
        </div>
        <div class="card-body">
            {% if vehicles_error is not null %}
                <div class="alert alert-warning" role="alert">{{ vehicles_error }}</div>
            {% elseif vehicles is empty %}
                <div class="alert alert-info" role="alert">
                    {{ __('Configure and save the API access above to list the fleet vehicles.', 'fleetview') }}
                </div>
            {% else %}
                <p class="text-secondary">
                    {{ __('Associate each Masternaut vehicle with a GLPI user. Rows marked "suggestion" are pre-filled from name matching: save to confirm them.', 'fleetview') }}
                </p>
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>{{ __('Vehicle', 'fleetview') }}</th>
                                <th>{{ __('Registration', 'fleetview') }}</th>
                                <th class="w-50">{{ 'User'|itemtype_name }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for vehicle in vehicles %}
                                <tr>
                                    <td>{{ vehicle.name }}</td>
                                    <td>{{ vehicle.registration }}</td>
                                    <td>
                                        <input type="hidden" name="labels[{{ vehicle.id }}]" value="{{ vehicle.name }}" />
                                        {% do call('User::dropdown', [{
                                            'name': 'mappings[' ~ vehicle.id ~ ']',
                                            'value': vehicle.users_id > 0 ? vehicle.users_id : vehicle.suggested_id,
                                            'right': 'all',
                                            'entity': -1,
                                            'width': '100%',
                                        }]) %}
                                        {% if vehicle.users_id == 0 and vehicle.suggested_id > 0 %}
                                            <span class="badge bg-yellow-lt ms-1">{{ __('suggestion', 'fleetview') }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
        {% if vehicles is not empty %}
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>
                    {{ __('Save') }}
                </button>
            </div>
        {% endif %}
    </div>
</form>
