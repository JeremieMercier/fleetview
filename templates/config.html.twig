{% import 'components/form/fields_macros.html.twig' as fields %}

<form method="post" action="{{ form_action }}" data-track-changes="true">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
    <input type="hidden" name="config_context" value="plugin:fleetview" />
    <input type="hidden" name="config_class" value="GlpiPlugin\Fleetview\PluginConfig" />

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-map-pin me-2"></i>
                {{ __('Masternaut (Michelin Connected Fleet) API', 'fleetview') }}
            </h3>
        </div>
        <div class="card-body">
            {{ fields.urlField(
                'api_base_url',
                config['api_base_url'],
                __('API base URL', 'fleetview'),
                {'full_width': true}
            ) }}

            {{ fields.textField(
                'customer_id',
                config['customer_id'],
                __('Connect customer number', 'fleetview'),
                {'full_width': true}
            ) }}

            {{ fields.textField(
                'api_username',
                config['api_username'],
                __('API username (Connect Partner user)', 'fleetview'),
                {'full_width': true}
            ) }}

            {{ fields.passwordField(
                'api_secret',
                '',
                __('API secret', 'fleetview'),
                {
                    'full_width': true,
                    'additional_attributes': {
                        'autocomplete': 'new-password',
                        'placeholder': __('Leave empty to keep the current secret', 'fleetview'),
                    },
                }
            ) }}

            {{ fields.numberField(
                'search_radius',
                config['search_radius'],
                __('Search radius (km)', 'fleetview'),
                {'min': 1, 'max': 500}
            ) }}

            {{ fields.numberField(
                'max_results',
                config['max_results'],
                __('Maximum number of vehicles displayed', 'fleetview'),
                {'min': 1, 'max': 100}
            ) }}

            {{ fields.numberField(
                'cache_lifetime',
                config['cache_lifetime'],
                __('Positions cache lifetime (seconds)', 'fleetview'),
                {'min': 0, 'max': 3600}
            ) }}
        </div>
        <div class="card-footer">
            <button type="submit" name="update" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1"></i>
                {{ __('Save') }}
            </button>
        </div>
    </div>
</form>
