{% import 'components/form/fields_macros.html.twig' as fields %}

<form method="post" action="{{ form_action }}" data-track-changes="true">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
    <input type="hidden" name="_tab" value="2" />

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-palette me-2"></i>
                {{ __('Customization', 'fleetview') }}
            </h3>
        </div>
        <div class="card-body">
            {{ fields.numberField(
                'search_radius',
                config['search_radius'],
                __('Search radius (km)', 'fleetview'),
                {'min': 1, 'max': 500}
            ) }}

            {{ fields.numberField(
                'max_results',
                config['max_results'],
                __('Maximum number of vehicles displayed', 'fleetview'),
                {'min': 1, 'max': 100}
            ) }}

            {{ fields.colorField(
                'marker_color_ticket',
                config['marker_color_ticket'],
                __('Marker color: ticket location', 'fleetview')
            ) }}

            {{ fields.colorField(
                'marker_color_top1',
                config['marker_color_top1'],
                __('Marker color: closest vehicle', 'fleetview')
            ) }}

            {{ fields.colorField(
                'marker_color_top2',
                config['marker_color_top2'],
                __('Marker color: 2nd closest', 'fleetview')
            ) }}

            {{ fields.colorField(
                'marker_color_top3',
                config['marker_color_top3'],
                __('Marker color: 3rd closest', 'fleetview')
            ) }}

            {{ fields.sliderField(
                'name_matching_fallback',
                config['name_matching_fallback'],
                __('Match technicians by name when a vehicle has no association', 'fleetview'),
                {
                    'helper': __('Only useful when vehicles are named after their technician. Explicit associations always take precedence.', 'fleetview'),
                }
            ) }}
        </div>
        <div class="card-footer">
            <button type="submit" name="update" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1"></i>
                {{ __('Save') }}
            </button>
        </div>
    </div>
</form>
