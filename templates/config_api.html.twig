{% import 'components/form/fields_macros.html.twig' as fields %}

<form method="post" action="{{ form_action }}" data-track-changes="true">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
    <input type="hidden" name="_tab" value="1" />

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-plug me-2"></i>
                {{ __('Masternaut (Michelin Connected Fleet) API', 'fleetview') }}
            </h3>
        </div>
        <div class="card-body">
            {{ fields.urlField(
                'api_base_url',
                config['api_base_url'],
                __('API base URL', 'fleetview'),
                {'full_width': true}
            ) }}

            {{ fields.textField(
                'customer_id',
                config['customer_id'],
                __('Connect customer number', 'fleetview'),
                {'full_width': true}
            ) }}

            {{ fields.textField(
                'api_username',
                config['api_username'],
                __('API username (Connect Partner user)', 'fleetview'),
                {'full_width': true}
            ) }}

            {{ fields.passwordField(
                'api_secret',
                '',
                __('API secret', 'fleetview'),
                {
                    'full_width': true,
                    'additional_attributes': {
                        'autocomplete': 'new-password',
                        'placeholder': __('Leave empty to keep the current secret', 'fleetview'),
                    },
                }
            ) }}

            {{ fields.numberField(
                'cache_lifetime',
                config['cache_lifetime'],
                __('Positions cache lifetime (seconds)', 'fleetview'),
                {'min': 0, 'max': 3600}
            ) }}

            {{ fields.urlField(
                'routing_base_url',
                config['routing_base_url'],
                __('Routing service URL (OSRM)', 'fleetview'),
                {
                    'full_width': true,
                    'helper': __('Driving times and road routes. The ticket site and vehicle coordinates are sent to this service on every map opening: prefer a self-hosted server. Empty (default) = disabled, the map still works without it.', 'fleetview'),
                    'additional_attributes': {
                        'placeholder': 'https://router.project-osrm.org',
                    },
                }
            ) }}

            {% if routing_external %}
                <div class="alert alert-warning d-flex align-items-center mb-0" role="alert">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <div>
                        {{ __('The routing service is hosted by a third party: the GPS coordinates of the ticket site and of the displayed vehicles are sent to it on every map opening, without any name or identifier, along with the IP address of your server. Make sure this transfer suits you, or self-host the service (see the README).', 'fleetview') }}
                    </div>
                </div>
            {% endif %}
        </div>
        <div class="card-footer">
            <button type="submit" name="update" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1"></i>
                {{ __('Save') }}
            </button>
        </div>
    </div>
</form>
